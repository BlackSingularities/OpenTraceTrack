    <string name="privacy_title">Privacy</string>
    <string name="privacy_local">Your tracks, markers and settings are stored only on this phone. There is no account, no analytics and no ads.</string>
    <string name="privacy_location">Location is used only for the HUD and while recording. In the background it works only during a recording, with a visible notification.</string>
    <string name="privacy_network">The internet is used only to download map tiles and to check for updates. Files leave the phone only when you export or share them.</string>
    <string name="privacy_crash">After a crash the error log stays on the phone – you decide whether to send it.</string>
