    <string name="onb_welcome_title">Welcome to OpenTraceTrack</string>
    <string name="onb_welcome_text">A speedometer with an aviation-style HUD and a GPS track recorder. Tracks stay on your phone and export to GPX, KML, GeoJSON and CSV.</string>
    <string name="onb_location_title">Location</string>
    <string name="onb_location_text">The HUD and recording use the phone\'s GPS. Choose “Precise” – with approximate location the track would be useless.</string>
    <string name="onb_notif_title">Notification</string>
    <string name="onb_notif_text">While recording, a notification shows distance and time and lets you pause or add a marker. Android requires it for recording in the background.</string>
    <string name="onb_battery_title">Long recordings</string>
    <string name="onb_battery_text">Some phones stop apps in the background to save battery. Allow OpenTraceTrack to run in the background so long tracks aren\'t cut short.</string>
